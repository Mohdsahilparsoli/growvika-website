---
// Homepage section (static markup).
---
<!-- ============ 3. SERVICES (pinned horizontal) ============ -->
<section class="svc pin" id="services">
  <div class="pin-sticky">
    <div class="wrap head-row">
      <div>
        <div class="idx rv"><b>02</b><span>What we do</span></div>
        <h2 class="h2 rv"><span class="mask"><span>Everything you need</span></span><span class="mask"><span>to <em class="s">grow online.</em></span></span></h2>
      </div>
      <div class="sl2-hr rv"><p class="lead">Pick one service or the whole stack. Every project is built mobile-first, fast and ready for Google.</p><div class="sl2-nav rail-nav"><button type="button" data-rail-prev aria-label="Previous service"><i class="fa-solid fa-arrow-left"></i></button><button type="button" data-rail-next aria-label="Next service"><i class="fa-solid fa-arrow-right"></i></button></div></div>
    </div>
    <div class="rail">
      <a href="#contact" class="card-s" data-open-modal data-svc="Website" data-cursor="view">
        <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=70" alt="Website development" loading="lazy">
        <div class="no">01<i class="fa-solid fa-arrow-right"></i></div>
        <div><h3>Website Development</h3><p>Business sites, landing pages and portals that load fast and bring enquiries.</p><ul><li>Business sites</li><li>Landing pages</li><li>WordPress / custom</li></ul></div>
      </a>
      <a href="#contact" class="card-s" data-open-modal data-svc="E-commerce" data-cursor="view">
        <img src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=800&q=70" alt="Online store checkout" loading="lazy">
        <div class="no">02<i class="fa-solid fa-arrow-right"></i></div>
        <div><h3>E-commerce Stores</h3><p>Online stores with payments, shipping and an easy admin to manage orders.</p><ul><li>Payments</li><li>Inventory</li><li>Shiprocket</li></ul></div>
      </a>
      <a href="#contact" class="card-s" data-open-modal data-svc="Mobile app" data-cursor="view">
        <img src="https://images.unsplash.com/photo-1551650975-87deedd944c3?auto=format&fit=crop&w=800&q=70" alt="Mobile app design" loading="lazy">
        <div class="no">03<i class="fa-solid fa-arrow-right"></i></div>
        <div><h3>Mobile Apps</h3><p>Android and iOS apps for bookings, orders, memberships and more.</p><ul><li>Android</li><li>iOS</li><li>Admin panel</li></ul></div>
      </a>
      <a href="#contact" class="card-s" data-open-modal data-svc="CRM" data-cursor="view">
        <img src="https://images.unsplash.com/photo-1686061592689-312bbfb5c055?auto=format&fit=crop&w=800&q=70" alt="CRM dashboard" loading="lazy">
        <div class="no">04<i class="fa-solid fa-arrow-right"></i></div>
        <div><h3>CRM Development</h3><p>Track every lead, follow-up, client and payment — built around how your team works.</p><ul><li>Lead stages</li><li>Follow-ups</li><li>Renewals</li></ul></div>
      </a>
      <a href="#contact" class="card-s" data-open-modal data-svc="Custom software" data-cursor="view">
        <img src="https://images.unsplash.com/photo-1547658719-da2b51169166?auto=format&fit=crop&w=800&q=70" alt="Custom software on screen" loading="lazy">
        <div class="no">05<i class="fa-solid fa-arrow-right"></i></div>
        <div><h3>Custom Software</h3><p>Billing, booking, inventory and internal tools that replace messy spreadsheets.</p><ul><li>Billing</li><li>Booking</li><li>Dashboards</li></ul></div>
      </a>
      <a href="#contact" class="card-s" data-open-modal data-svc="Digital marketing" data-cursor="view">
        <img src="https://images.unsplash.com/photo-1557838923-2985c318be48?auto=format&fit=crop&w=800&q=70" alt="Digital marketing planning" loading="lazy">
        <div class="no">06<i class="fa-solid fa-arrow-right"></i></div>
        <div><h3>Digital Marketing</h3><p>SEO, Google Business Profile, social media and Meta &amp; Google Ads that bring leads.</p><ul><li>SEO &amp; GMB</li><li>Social media</li><li>Ads</li></ul></div>
      </a>
      <div class="card-end">
        <h3>Not sure where to start?</h3>
        <div><p style="margin-bottom:22px;color:rgba(255,255,255,.85)">Tell us about your business. We'll suggest the right mix — no pressure.</p><button type="button" class="btn btn-w" data-open-modal>Free consultation <i class="fa-solid fa-arrow-right"></i></button></div>
      </div>
    </div>
    <div class="wrap rail-ui"><span class="cnt" data-rail-cnt>01 / 06</span><div class="bar"><i data-rail-bar></i></div></div>
  </div>
</section>

