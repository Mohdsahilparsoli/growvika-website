<!-- ============ 2. ABOUT ============ -->
<section class="sec about" id="about">
  <div class="wrap">
    <div class="ab-pics">
      <div class="p1 vid rv cl">
        <video autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=900&q=70" aria-label="GrowVika team at work">
          <source src="https://assets.mixkit.co/active_storage/video_items/100328/1722991554/100328-video-720.mp4" type="video/mp4">
        </video>
        <button type="button" class="vbtn" aria-label="Pause video"><i class="fa-solid fa-pause"></i></button>
      </div>
      <div class="p2 img rv cl d2"><img src="https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?auto=format&fit=crop&w=700&q=70" alt="Designer desk with laptop" loading="lazy"></div>
      <div class="tag rv d3"><b>1 team</b>for build &amp; marketing</div>
    </div>
    <div class="ab-txt">
      <div class="idx rv"><b>01</b><span>About GrowVika</span></div>
      <h2 class="h2 rv"><span class="mask"><span>Small team.</span></span><span class="mask"><span><em class="s">Serious</em> results.</span></span></h2>
      <p class="statement rv" style="margin-top:28px">We are a Delhi NCR digital agency that builds and markets — so your website, app and leads all work together.</p>
      <p class="rv">Most local businesses end up with one person for the website, another for ads, and a spreadsheet for leads. Nothing talks to each other. GrowVika puts it under one roof: we design and code your site or app, set up a CRM for your enquiries, and run the SEO and ads that fill it.</p>
      <div class="mv rv">
        <div><i class="fa-solid fa-bullseye"></i><h4>Our mission</h4><p>Give every growing business a professional online presence at a fair, fixed price.</p></div>
        <div><i class="fa-solid fa-eye"></i><h4>Our vision</h4><p>Be the first team NCR businesses call when they want to grow online.</p></div>
      </div>
      <div class="sign rv">
        <div class="who"><span>MS</span><div><b>Md Sahil</b><small>Founder, GrowVika</small></div></div>
        <a href="#process" class="link">How we work <i class="fa-solid fa-arrow-right"></i></a>
      </div>
    </div>
  </div>
</section>

