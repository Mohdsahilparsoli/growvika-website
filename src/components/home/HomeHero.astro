---
// Homepage section (static markup).
---
<!-- ============ 1. HERO ============ -->
<section class="hero">
  <div class="wrap">
    <div class="hero-txt rv">
      <h1>
        <span class="mask"><span>We build brands</span></span>
        <span class="mask"><span>that <em class="s rot" aria-label="grow"><span class="on">grow</span><span aria-hidden="true">sell</span><span aria-hidden="true">scale</span><span aria-hidden="true">shine</span><span aria-hidden="true">win</span></em></span></span>
        <span class="mask"><span><span class="ul">online.<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 14 C 80 4, 200 2, 296 10"/></svg></span></span></span>
      </h1>
      <p class="lead">Websites, mobile apps, CRM, custom software and digital marketing. One team that builds your business online, then keeps it growing.</p>
      <ul class="ticks">
        <li><i class="fa-solid fa-check"></i>Fixed, clear pricing</li>
        <li><i class="fa-solid fa-check"></i>Mobile-first &amp; fast</li>
        <li><i class="fa-solid fa-check"></i>SEO-ready from day one</li>
        <li><i class="fa-solid fa-check"></i>Support after launch</li>
      </ul>
      <div class="hero-ctas">
        <button type="button" class="btn btn-i" data-open-modal>Start a new project <i class="fa-solid fa-arrow-right"></i></button>
        <a href="#work" class="btn btn-o">See our work</a>
      </div>
      <div class="hero-trust">
        <div class="chips" aria-hidden="true"><span><i class="fa-solid fa-code"></i></span><span><i class="fa-solid fa-mobile-screen"></i></span><span><i class="fa-solid fa-users-gear"></i></span><span><i class="fa-solid fa-chart-line"></i></span></div>
        <p><b>Build + marketing, one roof.</b><br>No juggling between a developer and a marketing agency.</p>
      </div>
    </div>

    <div class="h-vis rv d2">
      <div class="hs" data-hs>
        <div class="bars"></div>
        <div class="s on"><img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1100&q=70" alt="Team working together on a client project" fetchpriority="high"></div>
        <div class="s"><img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1100&q=70" alt="Website code on a laptop" loading="lazy"></div>
        <div class="s"><img src="https://images.unsplash.com/photo-1551650975-87deedd944c3?auto=format&fit=crop&w=1100&q=70" alt="Mobile app screens" loading="lazy"></div>
        <div class="s"><img src="https://images.unsplash.com/photo-1686061592689-312bbfb5c055?auto=format&fit=crop&w=1100&q=70" alt="Marketing analytics dashboard" loading="lazy"></div>
        <div class="cap">
          <small data-hs-k>Website development</small><b data-hs-t>Sites that turn visitors into enquiries</b>
        </div>
      </div>
      <div class="h-sub img"><img src="https://images.unsplash.com/photo-1603201667230-bd139210db18?auto=format&fit=crop&w=500&q=70" alt="Client meeting" loading="lazy"></div>
      <div class="h-badge b1"><span class="ic"><i class="fa-solid fa-bolt"></i></span><span><b>Live in 7–15 days</b><small>for most business sites</small></span></div>
      <div class="h-badge b2"><span class="ic"><i class="fa-brands fa-whatsapp"></i></span><span><b>Reply on WhatsApp</b><small>talk to the builder directly</small></span></div>
      <div class="h-exp"><b>11+</b><span>services under one roof</span></div>
      <div class="spin" aria-hidden="true">
        <svg viewBox="0 0 124 124"><defs><path id="circ" d="M62,62 m-48,0 a48,48 0 1,1 96,0 a48,48 0 1,1 -96,0"/></defs><text><textPath href="#circ">Start a project • Start a project • </textPath></text></svg>
        <i class="fa-solid fa-arrow-right"></i>
      </div>
    </div>
  </div>
</section>

<!-- marquee -->
<div class="marq-wrap"><div class="marq" aria-hidden="true"><div class="tr">
  <span>Websites <i class="fa-solid fa-asterisk"></i> <em>Mobile apps</em> <i class="fa-solid fa-asterisk"></i> CRM <i class="fa-solid fa-asterisk"></i> <em>Custom software</em> <i class="fa-solid fa-asterisk"></i> SEO <i class="fa-solid fa-asterisk"></i> <em>Social media</em> <i class="fa-solid fa-asterisk"></i> Google &amp; Meta Ads <i class="fa-solid fa-asterisk"></i></span>
  <span>Websites <i class="fa-solid fa-asterisk"></i> <em>Mobile apps</em> <i class="fa-solid fa-asterisk"></i> CRM <i class="fa-solid fa-asterisk"></i> <em>Custom software</em> <i class="fa-solid fa-asterisk"></i> SEO <i class="fa-solid fa-asterisk"></i> <em>Social media</em> <i class="fa-solid fa-asterisk"></i> Google &amp; Meta Ads <i class="fa-solid fa-asterisk"></i></span>
</div></div></div>

