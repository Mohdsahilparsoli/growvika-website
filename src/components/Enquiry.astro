---
// Enquiry form (sent by agency.js via FormSubmit, mailto fallback).
import Idx from "./Idx.astro";
import H2 from "./H2.astro";
const { id = "enquiry", label = "Enquiry", n, a = "Let's build something", b = '<em class="s">that grows.</em>' } = Astro.props;
---
<!-- ============ 12. ENQUIRY ============ -->
<section class="sec enq" id={id}>
  <div class="wrap">
    <div class="enq-g">
      <div>
        <Idx label={label} n={n} />
        <H2 a={a} b={b} />
        <div class="ct rv">
          <div><i class="fa-solid fa-phone"></i><span><small>Call</small><a href="tel:+919818186876">+91-9818186876</a></span></div>
          <div><i class="fa-regular fa-envelope"></i><span><small>Email</small><a href="mailto:sahil@growvika.com">sahil@growvika.com</a></span></div>
          <div><i class="fa-brands fa-whatsapp"></i><span><small>WhatsApp</small><a href="https://wa.me/919818186876" target="_blank" rel="noopener">Chat with us</a></span></div>
          <div><i class="fa-solid fa-location-dot"></i><span><small>Visit</small><b>Delhi NCR — we come to you</b></span></div>
          <div><i class="fa-regular fa-clock"></i><span><small>Hours</small><b>Mon – Sat, 10:00 AM – 7:00 PM</b></span></div>
        </div>
      </div>
      <form class="ef rv" id="eform" novalidate>
        <div><label for="e-name">Name *</label><input id="e-name" name="name" placeholder="Your full name" required autocomplete="name"></div>
        <div><label for="e-phone">Phone *</label><input id="e-phone" name="phone" type="tel" placeholder="+91" required inputmode="tel" autocomplete="tel"></div>
        <div><label for="e-email">Email</label><input id="e-email" name="email" type="email" placeholder="you@company.com" autocomplete="email"></div>
        <div><label for="e-biz">Business</label><input id="e-biz" name="biz" placeholder="Business name" autocomplete="organization"></div>
        <div><label for="e-svc">Service *</label><select id="e-svc" name="svc" required><option value="">Choose…</option><option>Website</option><option>E-commerce store</option><option>Mobile app</option><option>CRM</option><option>Custom software</option><option>SEO / Google Business Profile</option><option>Social media &amp; ads</option><option>Not sure yet</option></select></div>
        <div><label for="e-time">Timeline</label><select id="e-time" name="time"><option value="">Choose…</option><option>As soon as possible</option><option>Within a month</option><option>1–3 months</option><option>Just exploring</option></select></div>
        <div class="full"><label for="e-msg">Requirement</label><textarea id="e-msg" name="msg" placeholder="Tell us about your business and what you need…"></textarea></div>
        <div class="full"><button type="submit" class="btn btn-d">Send enquiry <i class="fa-solid fa-arrow-right"></i></button><p class="form-msg" role="status">Thanks! Your enquiry has been sent — we'll get back to you the same day.</p></div>
      </form>
    </div>
    <div class="map rv"><iframe title="GrowVika service area: Delhi NCR" src="https://www.google.com/maps?q=New+Delhi,+Delhi+NCR&z=10&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><a class="map-open" href="https://www.google.com/maps?q=New+Delhi" target="_blank" rel="noopener">Open in Maps <i class="fa-solid fa-arrow-up-right-from-square"></i></a></div>
  </div>
</section>
