---
// Pinned horizontal slider shell (agency.js pins it on desktop).
import Idx from "./Idx.astro";
import H2 from "./H2.astro";
const { cls, label, a, b, lead } = Astro.props;
---
<section class={cls}>
 <div class="sl2-sticky">
  <div class="wrap">
    <div class="head-row">
      <div>
        <Idx label={label} />
        <H2 a={a} b={b} />
      </div>
      <div class="sl2-hr rv">{lead && <p class="lead" set:html={lead} />}<div class="sl2-nav"><span class="sl2-bar"><i></i></span><button type="button" data-sl2-prev aria-label="Previous"><i class="fa-solid fa-arrow-left"></i></button><button type="button" data-sl2-next aria-label="Next"><i class="fa-solid fa-arrow-right"></i></button></div></div>
    </div>
  </div>
  <div class="sl2" data-sl2>
    <div class="sl2-track">
<slot />
    </div>
  </div>
 </div>
</section>
